---
import {
	pageCopy,
	profile,
	type Lang,
	ui,
} from '../../data/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLangPaths, isLang } from '../../lib/i18n';

export function getStaticPaths() {
	return getLangPaths();
}

const { lang: langParam } = Astro.params;
if (!isLang(langParam)) throw new Error('Unsupported language');
const lang: Lang = langParam;
const t = pageCopy.cv[lang];
const common = ui[lang];
const description =
	lang === 'en'
		? 'Curriculum vitae of Shiuan-Ting Lin: AI systems experience at Nokia, explainable AI research at Ericsson, and graduate training in statistics.'
		: '林宣廷個人履歷：Nokia AI 系統經歷、Ericsson 可解釋 AI 研究，以及統計學研究所訓練。';
---

<BaseLayout lang={lang} title={t.eyebrow} description={description}>
	<header class="page-hero shell">
		<h1>{lang === 'en' ? 'CV' : '履歷'}</h1>
	</header>

	<section class="section section--tint">
		<div class="shell">
			<div class="cv-banner">
				<div>
					<h2>{lang === 'en' ? 'PDF preview' : 'PDF 預覽'}</h2>
					<p>{t.download}</p>
				</div>
				<div class="button-row">
					<a class="button" href={profile.cv} target="_blank">{common.viewCv}</a>
					<a class="button button--ghost" href={profile.cv} download>{common.downloadCv}</a>
				</div>
			</div>
			<div
				class="cv-preview"
				aria-label={lang === 'en' ? 'Shiuan-Ting Lin CV PDF preview' : '林宣廷 PDF 履歷預覽'}
			>
				<img
					src="/images/cv/page-1.jpg"
					alt={lang === 'en' ? 'CV page 1 of 2' : '履歷第 1 頁，共 2 頁'}
					width="1102"
					height="1426"
				/>
				<img
					src="/images/cv/page-2.jpg"
					alt={lang === 'en' ? 'CV page 2 of 2' : '履歷第 2 頁，共 2 頁'}
					width="1102"
					height="1426"
					loading="lazy"
				/>
			</div>
		</div>
	</section>
</BaseLayout>
