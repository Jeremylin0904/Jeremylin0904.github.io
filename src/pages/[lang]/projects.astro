---
import ProjectCard from '../../components/ProjectCard.astro';
import { pageCopy, projects, type Lang } from '../../data/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLangPaths, isLang } from '../../lib/i18n';

export function getStaticPaths() {
	return getLangPaths();
}

const { lang: langParam } = Astro.params;
if (!isLang(langParam)) throw new Error('Unsupported language');
const lang: Lang = langParam;
const t = pageCopy.projects[lang];
const practicalProjects = projects.filter((project) => !project.featured);
const description =
	lang === 'en'
		? 'Machine learning and computer vision projects by Shiuan-Ting Lin.'
		: '林宣廷的機器學習與電腦視覺實作專案。';
---

<BaseLayout lang={lang} title={t.eyebrow} description={description}>
	<header class="page-hero shell">
		<h1>{t.eyebrow}</h1>
	</header>

	<section class="section section--tint">
		<div class="shell">
			<header class="section-heading section-heading--compact">
				<h2>{t.archive}</h2>
			</header>
			<div class="project-grid">
				{practicalProjects.map((project) => <ProjectCard project={project} lang={lang} />)}
			</div>
		</div>
	</section>
</BaseLayout>
