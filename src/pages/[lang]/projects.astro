---
import ProjectCard from '../../components/ProjectCard.astro';
import { pageCopy, projects, type Lang } from '../../data/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLangPaths, isLang } from '../../lib/i18n';

export function getStaticPaths() {
	return getLangPaths();
}

const { lang: langParam } = Astro.params;
if (!isLang(langParam)) throw new Error('Unsupported language');
const lang: Lang = langParam;
const t = pageCopy.projects[lang];
const featured = projects.filter((project) => project.featured);
const archive = projects.filter((project) => !project.featured);
const description =
	lang === 'en'
		? 'Research and machine learning projects by Shiuan-Ting Lin, including explainable AI, sparse representations, self-supervised video learning, and computer vision.'
		: '林宣廷的研究與機器學習專案，涵蓋可解釋 AI、稀疏表徵、自監督影片學習與電腦視覺。';
---

<BaseLayout lang={lang} title={t.eyebrow} description={description}>
	<header class="page-hero shell">
		<p class="eyebrow">{t.eyebrow}</p>
		<h1>{t.title}</h1>
		<p class="page-hero__intro">{t.intro}</p>
	</header>

	<section class="section section--tint">
		<div class="shell">
			<header class="section-heading">
				<h2>{t.featured}</h2>
				<p>
					{
						lang === 'en'
							? 'Long-form investigations completed at NYCU and Ericsson R&D / KTH.'
							: '在 NYCU 與 Ericsson R&D／KTH 完成的長期研究。'
					}
				</p>
			</header>
			<div class="project-grid">
				{featured.map((project) => <ProjectCard project={project} lang={lang} showDetail />)}
			</div>
		</div>
	</section>

	<section class="section shell">
		<header class="section-heading">
			<h2>{t.archive}</h2>
			<p>
				{
					lang === 'en'
						? 'Reproductions and practical systems that broadened my view of learning from visual data.'
						: '拓展我對視覺資料學習理解的復現與系統實作。'
				}
			</p>
		</header>
		<div class="project-grid">
			{archive.map((project) => <ProjectCard project={project} lang={lang} showDetail />)}
		</div>
	</section>
</BaseLayout>
