---
import { Image } from 'astro:assets';
import { home, profile, type Lang } from '../../data/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLangPaths, isLang, localizedPath } from '../../lib/i18n';
import portrait from '../../assets/home-portrait.jpg';

export function getStaticPaths() {
	return getLangPaths();
}

const { lang: langParam } = Astro.params;
if (!isLang(langParam)) throw new Error('Unsupported language');
const lang: Lang = langParam;
const t = home[lang];
const researchFocus =
	lang === 'en'
		? 'World Models · Predictive Learning · Computer Vision · Embodied AI'
		: '世界模型 · 預測式學習 · 電腦視覺 · 具身智慧';
const description =
	lang === 'en'
		? 'Shiuan-Ting (Jeremy) Lin is a Solution Architect at Nokia with a background in mathematics and statistics. His research interests include world models, predictive representation learning, self-supervised learning, computer vision, and embodied intelligence.'
		: '林宣廷（Jeremy）目前任職 Nokia Solution Architect，具數學與統計背景，研究興趣包括世界模型、預測式表徵學習、自監督學習、電腦視覺與具身智慧。';
---

<BaseLayout lang={lang} title={profile.name} description={description}>
	<section class="hero shell">
		<div class="hero__copy">
			<p class="eyebrow">{researchFocus}</p>
			<h1 class="sr-only">{profile.name}</h1>
			<p class="hero__summary">{t.summary}</p>
			<div class="button-row">
				<a class="button" href={localizedPath(lang, 'research')}>
					{t.primaryCta} <span aria-hidden="true">↗</span>
				</a>
				<a class="button button--ghost" href={localizedPath(lang, 'about')}>
					{t.secondaryCta}
				</a>
			</div>
			<nav
				class="hero-socials"
				aria-label={lang === 'en' ? 'Contact and social profiles' : '聯絡方式與社群'}
			>
				<a href={`mailto:${profile.email}`}>Email <span aria-hidden="true">↗</span></a>
				<a href={profile.linkedin} target="_blank" rel="noreferrer">
					LinkedIn <span aria-hidden="true">↗</span>
				</a>
				<a href={profile.github} target="_blank" rel="noreferrer">
					GitHub <span aria-hidden="true">↗</span>
				</a>
			</nav>
		</div>

		<figure class="hero-portrait">
			<div class="hero-portrait__frame">
				<Image
					src={portrait}
					alt={lang === 'en' ? 'Portrait of Shiuan-Ting Lin' : '林宣廷個人肖像'}
					widths={[420, 720, 960]}
					sizes="(max-width: 900px) 80vw, 32vw"
					format="webp"
					loading="eager"
					fetchpriority="high"
				/>
			</div>
			<figcaption class="hero-portrait__caption">
				<span>{profile.location[lang]}</span>
				<span>AI × Statistics</span>
			</figcaption>
		</figure>
	</section>

	<section class="section section--tint">
		<div class="approach shell">
			<div>
				<h2>{t.approachTitle}</h2>
			</div>
			<div>
				<p class="approach__intro">{t.approachBody}</p>
				<ul class="thread-list">
					{
						t.threads.map(([title, body]) => (
							<li>
								<strong>{title}</strong>
								<p>{body}</p>
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</section>
</BaseLayout>
