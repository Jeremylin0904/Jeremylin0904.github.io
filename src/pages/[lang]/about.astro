---
import { Image } from 'astro:assets';
import { about, awards, education, experience, type Lang } from '../../data/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLangPaths, isLang } from '../../lib/i18n';
import portrait from '../../assets/portrait.jpg';

export function getStaticPaths() {
	return getLangPaths();
}

const { lang: langParam } = Astro.params;
if (!isLang(langParam)) throw new Error('Unsupported language');
const lang: Lang = langParam;
const t = about[lang];
const description =
	lang === 'en'
		? 'About Shiuan-Ting Lin: a statistician and AI practitioner connecting trustworthy machine learning, representation learning, and network systems.'
		: '關於林宣廷：結合統計、可信賴機器學習、表徵學習與網路系統的 AI 實務工作者。';
---

<BaseLayout lang={lang} title={t.eyebrow} description={description}>
	<header class="page-hero shell">
		<p class="eyebrow">{t.eyebrow}</p>
		<h1>{t.title}</h1>
	</header>

	<section class="section section--tint">
		<div class="bio-layout shell">
			<figure class="bio-layout__portrait">
				<Image
					src={portrait}
					alt={lang === 'en' ? 'Shiuan-Ting Lin in Taipei' : '林宣廷於台北'}
					widths={[400, 700]}
					sizes="(max-width: 900px) 80vw, 30vw"
					format="webp"
				/>
			</figure>
			<div class="bio-copy">
				{t.bio.map((paragraph) => <p>{paragraph}</p>)}
			</div>
		</div>
	</section>

	<section class="section shell">
		<header class="section-heading">
			<h2>{t.experienceTitle}</h2>
			<p>
				{
					lang === 'en'
						? 'Applying research habits to operational problems in telecom AI.'
						: '把研究方法帶進電信 AI 的實際維運問題。'
				}
			</p>
		</header>
		<ol class="timeline">
			{
				experience.map((item) => (
					<li class="timeline__item">
						<p class="timeline__period">{item.period[lang]}</p>
						<div>
							<h3>{item.org}</h3>
							<p class="timeline__role">{item.role[lang]}</p>
							<p class="timeline__location">{item.location[lang]}</p>
							<ul class="timeline__points">
								{item.points[lang].map((point) => <li>{point}</li>)}
							</ul>
						</div>
					</li>
				))
			}
		</ol>
	</section>

	<section class="section section--tint">
		<div class="shell">
			<header class="section-heading">
				<h2>{t.educationTitle}</h2>
				<p>
					{
						lang === 'en'
							? 'Mathematics, statistics, and computer science across Taiwan and Sweden.'
							: '在台灣與瑞典累積數學、統計與資訊科學訓練。'
					}
				</p>
			</header>
			<ul class="simple-list">
				{
					education.map((item) => (
						<li class="simple-list__item">
							<div>
								<h3>{item.school}</h3>
								<p>{item.degree[lang]}</p>
							</div>
							<time>{item.period}</time>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section class="section shell">
		<header class="section-heading">
			<h2>{t.awardsTitle}</h2>
			<p>{t.awardsIntro}</p>
		</header>
		<div class="award-grid">
			{
				awards.map((award) => (
					<article class="award-card">
						<time>{award.year}</time>
						<h3>{award.title[lang]}</h3>
						<p>{award.note[lang]}</p>
					</article>
				))
			}
		</div>
	</section>
</BaseLayout>
