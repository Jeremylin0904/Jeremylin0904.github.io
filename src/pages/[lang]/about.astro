---
import { Image } from 'astro:assets';
import {
	about,
	awards,
	education,
	experience,
	pageCopy,
	skills,
	type Lang,
} from '../../data/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLangPaths, isLang } from '../../lib/i18n';
import portrait from '../../assets/portrait.jpg';

export function getStaticPaths() {
	return getLangPaths();
}

const { lang: langParam } = Astro.params;
if (!isLang(langParam)) throw new Error('Unsupported language');
const lang: Lang = langParam;
const t = about[lang];
const cvCopy = pageCopy.cv[lang];
const description =
	lang === 'en'
		? 'About Shiuan-Ting Lin: a statistician and AI practitioner connecting trustworthy machine learning, representation learning, and network systems.'
		: '關於林宣廷：結合統計、可信賴機器學習、表徵學習與網路系統的 AI 實務工作者。';
---

<BaseLayout lang={lang} title={t.eyebrow} description={description}>
	<header class="page-hero shell">
		<h1>{t.eyebrow}</h1>
	</header>

	<section class="section section--tint">
		<div class="bio-layout shell">
			<figure class="bio-layout__portrait">
				<Image
					src={portrait}
					alt={lang === 'en' ? 'Shiuan-Ting Lin in Taipei' : '林宣廷於台北'}
					widths={[400, 700]}
					sizes="(max-width: 900px) 80vw, 30vw"
					format="webp"
				/>
			</figure>
			<div class="bio-copy">
				{t.bio.map((paragraph) => <p>{paragraph}</p>)}
			</div>
		</div>
	</section>

	<section class="section shell">
		<header class="section-heading section-heading--compact">
			<h2>{cvCopy.experience}</h2>
		</header>
		<ol class="timeline">
			{
				experience.map((item) => (
					<li class="timeline__item">
						<p class="timeline__period">{item.period[lang]}</p>
						<div>
							<div class="entity-heading">
								<img
									class="entity-logo"
									src={item.logo}
									alt=""
									width="88"
									height="48"
									loading="lazy"
								/>
								<h3>{item.org}</h3>
							</div>
							<p class="timeline__role">{item.role[lang]}</p>
							<p class="timeline__location">{item.location[lang]}</p>
							<ul class="timeline__points">
								{item.points[lang].map((point) => <li>{point}</li>)}
							</ul>
						</div>
					</li>
				))
			}
		</ol>
	</section>

	<section class="section section--tint">
		<div class="about-details-grid shell">
			<div class="about-details-group">
				<header class="section-heading section-heading--compact">
					<h2>{cvCopy.education}</h2>
				</header>
				<ul class="simple-list">
					{
						education.map((item) => (
							<li class="simple-list__item">
								<div>
									<div class="entity-heading">
										<img
											class="entity-logo"
											src={item.logo}
											alt=""
											width="88"
											height="48"
											loading="lazy"
										/>
										<h3>{item.school}</h3>
									</div>
									<p>{item.degree[lang]}</p>
								</div>
								<time>{item.period}</time>
							</li>
						))
					}
				</ul>
			</div>

			<div class="about-details-group">
				<header class="section-heading section-heading--compact">
					<h2>{cvCopy.skills}</h2>
				</header>
				<ul class="skill-list skill-list--stacked">
					{
						skills.map((skill) => (
							<li>
								<strong>{skill.label[lang]}</strong>
								<span>{skill.items}</span>
							</li>
						))
					}
				</ul>
			</div>

			<div class="about-details-group">
				<header class="section-heading section-heading--compact">
					<h2>{lang === 'en' ? 'Selected recognition' : '獲獎紀錄'}</h2>
				</header>
				<div class="award-grid award-grid--stacked">
					{
						awards.map((award) => (
							<article class="award-card">
								<time>{award.year}</time>
								<h3>{award.title[lang]}</h3>
								<p>{award.note[lang]}</p>
							</article>
						))
					}
				</div>
			</div>
		</div>
	</section>
</BaseLayout>
