---
import { Image } from 'astro:assets';
import { about, type Lang, ui } from '../../data/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLangPaths, isLang, localizedPath } from '../../lib/i18n';
import portrait from '../../assets/portrait.jpg';

export function getStaticPaths() {
	return getLangPaths();
}

const { lang: langParam } = Astro.params;
if (!isLang(langParam)) throw new Error('Unsupported language');
const lang: Lang = langParam;
const t = about[lang];
const common = ui[lang];
const description =
	lang === 'en'
		? 'About Shiuan-Ting Lin: a statistician and AI practitioner connecting trustworthy machine learning, representation learning, and network systems.'
		: '關於林宣廷：結合統計、可信賴機器學習、表徵學習與網路系統的 AI 實務工作者。';
---

<BaseLayout lang={lang} title={t.eyebrow} description={description}>
	<header class="page-hero shell">
		<h1>{t.eyebrow}</h1>
	</header>

	<section class="section section--tint">
		<div class="bio-layout shell">
			<figure class="bio-layout__portrait">
				<Image
					src={portrait}
					alt={lang === 'en' ? 'Shiuan-Ting Lin in Taipei' : '林宣廷於台北'}
					widths={[400, 700]}
					sizes="(max-width: 900px) 80vw, 30vw"
					format="webp"
				/>
			</figure>
			<div class="bio-copy">
				{t.bio.map((paragraph) => <p>{paragraph}</p>)}
				<div class="button-row bio-copy__actions">
					<a class="button" href={localizedPath(lang, 'cv')}>{common.viewCv}</a>
					<a class="button button--ghost" href={localizedPath(lang, 'projects')}>
						{lang === 'en' ? 'View projects' : '查看專案'}
					</a>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>
