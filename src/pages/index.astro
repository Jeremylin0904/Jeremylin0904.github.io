---
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta
			name="description"
			content="林宣廷 · Shiuan-Ting Lin (Jeremy) — Nokia Solution Architect with a mathematics and statistics background, interested in world models, predictive representation learning, computer vision, self-supervised learning, and embodied AI."
		/>
		<meta name="robots" content="index,follow,max-image-preview:large" />
		<link rel="canonical" href="https://jeremylin0904.github.io/en/" />
		<link rel="alternate" hreflang="en" href="https://jeremylin0904.github.io/en/" />
		<link rel="alternate" hreflang="zh-Hant" href="https://jeremylin0904.github.io/zh/" />
		<link rel="alternate" hreflang="x-default" href="https://jeremylin0904.github.io/en/" />
		<meta http-equiv="refresh" content="0; url=/en/" />
		<title>林宣廷 · Shiuan-Ting Lin (Jeremy)</title>
		<script is:inline>
			window.location.replace('/en/');
		</script>
	</head>
	<body>
		<main class="root-redirect">
			<div>
				<h1>林宣廷 · Shiuan-Ting Lin (Jeremy)</h1>
				<p>Redirecting to the English homepage.</p>
				<nav aria-label="Language">
					<a class="button" href="/en/">Continue in English</a>
					<a class="button button--ghost" href="/zh/">繁體中文</a>
				</nav>
			</div>
		</main>
	</body>
</html>
