---
import type { Lang, Project } from '../data/site';

interface Props {
	project: Project;
	lang: Lang;
	showDetail?: boolean;
	compact?: boolean;
}

const { project, lang, showDetail = false, compact = false } = Astro.props;
---

<article
	class:list={['project-card', { 'project-card--compact': compact }]}
	data-accent={project.accent}
	id={project.slug}
>
	<div class="project-card__visual">
		<img
			src={project.image}
			alt={project.imageAlt[lang]}
			width="1200"
			height="675"
			loading="lazy"
			decoding="async"
		/>
	</div>
	<div class="project-card__meta">
		<span>{project.category[lang]}</span>
		<span>{project.year}</span>
	</div>
	<h3>{project.title[lang]}</h3>
	<p class="project-card__summary">{project.summary[lang]}</p>
	{showDetail && <p class="project-card__detail">{project.detail[lang]}</p>}
	<ul class="tag-list" aria-label="Technologies and topics">
		{project.tags.map((tag) => <li class="tag">{tag}</li>)}
	</ul>
	<div class="project-card__links">
		{
			project.links.map((link) => (
				<a class="text-link" href={link.url} target="_blank" rel="noreferrer">
					{link.label[lang]} <span aria-hidden="true">↗</span>
				</a>
			))
		}
	</div>
</article>
